{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "E-Learning Guru",
  "version": "0.1.2",
  "identifier": "com.sekolah.elearning.guru",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "E-Learning Guru", "fullscreen": true, "decorations": false, "resizable": false }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
